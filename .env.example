# ─────────────────────────────────────────────────────────────────
# LOOKING GLASS — Environment Configuration
# ─────────────────────────────────────────────────────────────────

# ── AI Provider Configuration ──────────────────────────────────────
# Primary: OmniRoute (local gateway — http://127.0.0.1:20128/v1)
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=omniroute
LLM_MODEL=auto/best-coding-fast

# Fallback models (used when primary is unavailable)
LLM_FALLBACK_MODEL_1=auto/best-coding
LLM_FALLBACK_MODEL_2=auto/best-reasoning

# OpenRouter Fallback (disabled — OmniRoute is primary)
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_FALLBACK_MODEL=openrouter/free

# ── Production (Cloudflare Tunnel) ───────────────────────────────
# When deployed, expose the local gemini-web2api via Cloudflare Tunnel:
#   cloudflared tunnel run <your-tunnel-name>
# Then set:
# LLM_BASE_URL=https://<your-tunnel>.trycloudflare.com/v1

# ── Optional Providers ────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# ── Vercel / Deployment ──────────────────────────────────────────
# In Vercel dashboard, set these environment variables:
#   LLM_BASE_URL     → https://<your-tunnel>.trycloudflare.com/v1
#   OPENROUTER_API_KEY → sk-or-... (fallback)